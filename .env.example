# Copy to `.env` and fill in values. Never commit `.env` or `.pem` files.
#
# GitHub App (required for real repo scan + PR flow)
# In GitHub App settings set:
#   Homepage URL:     https://YOUR_DOMAIN
#   Callback / Setup: https://YOUR_DOMAIN/api/github/install
# Optional webhook:   https://YOUR_DOMAIN/api/github/webhook
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Optional AI providers (changelog analysis). Catalog rules work when these are empty.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional PostgreSQL. Without DATABASE_URL, demo mode keeps migration runs in memory.
DATABASE_URL=
