# GitHub App. Never commit real values.
# Production: set Homepage + Setup URL on the app to https://YOUR_DOMAIN
# Setup URL path: /api/github/install
# Webhook (optional on Vercel): https://YOUR_DOMAIN/api/github/webhook
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=

# Optional model providers. Catalog rules run when these are empty.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# PostgreSQL. Demo mode keeps runs in memory when this is unset.
DATABASE_URL=
